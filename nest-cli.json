{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/my-lowcode/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/my-lowcode/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/my-lowcode",
  "generateOptions": {
    "spec": false
  },
  "projects": {
    "my-lowcode": {
      "type": "application",
      "root": "apps/my-lowcode",
      "entryFile": "main",
      "sourceRoot": "apps/my-lowcode/src",
      "compilerOptions": {
        "tsConfigPath": "apps/my-lowcode/tsconfig.app.json"
      }
    },
    "devops": {
      "type": "application",
      "root": "apps/devops",
      "entryFile": "main",
      "sourceRoot": "apps/devops/src",
      "compilerOptions": {
        "tsConfigPath": "apps/devops/tsconfig.app.json"
      }
    },
    "comm": {
      "type": "library",
      "root": "libs/comm",
      "entryFile": "index",
      "sourceRoot": "libs/comm/src",
      "compilerOptions": {
        "tsConfigPath": "libs/comm/tsconfig.lib.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    }
  }
}
